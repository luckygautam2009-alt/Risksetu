# RISKSETU AI — Frontend Environment Configuration
# Copy this file to .env and adjust for your local setup or Render dashboard.

# --- Map Configuration ---
# Override the default OpenStreetMap basemap style (optional)
# VITE_MAP_STYLE=https://api.maptiler.com/maps/topo-v2/style.json?key=YOUR_KEY
# VITE_MAP_API_KEY=YOUR_MAP_API_KEY

# --- Backend API URL ---
# In local development: defaults to http://localhost:8000
# In Render.com Static Site deployment: MUST be set to your deployed backend Web Service URL, e.g.:
# VITE_API_BASE_URL=https://risksetu-api.onrender.com
# Note: Do not leave undefined in production, otherwise requests default to relative paths
# and will not reach the backend Web Service.
VITE_API_BASE_URL=http://localhost:8000