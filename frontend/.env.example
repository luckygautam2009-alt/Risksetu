# RISKSETU AI — Frontend Environment Configuration
# Copy this file to .env and adjust for your local setup.

# --- Map Configuration ---
# Override the default OpenStreetMap basemap style (optional)
# VITE_MAP_STYLE=https://api.maptiler.com/maps/topo-v2/style.json?key=YOUR_KEY
# VITE_MAP_API_KEY=YOUR_MAP_API_KEY

# --- Backend API ---
# Base URL for the RISKSETU backend API (defaults to relative path / proxy)
# VITE_API_BASE_URL=http://localhost:8000
