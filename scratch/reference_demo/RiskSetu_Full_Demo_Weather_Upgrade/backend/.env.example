DATA_MODE=mock

# Optional fallback weather provider
INDIANAPI_KEY=
INDIANAPI_WEATHER_BASE_URL=https://weather.indianapi.in

# Free Open-Meteo endpoints; no key required for normal non-commercial prototype use
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
WEATHER_CACHE_SECONDS=900
TERRAIN_CACHE_SECONDS=86400
FLOOD_CACHE_SECONDS=1800

# Optional NASA PPS IMERG Early Run
PPS_USERNAME=
PPS_PASSWORD=
EARTHDATA_TOKEN=
NASA_IMERG_PPS_BASE_URL=https://jsimpsonhttps.pps.eosdis.nasa.gov/imerg/gis/early/
IMERG_CACHE_SECONDS=1800

# Routing
OSRM_BASE_URL=https://router.project-osrm.org

# Optional live Supabase mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Gemini assistance
GEMINI_API_KEY=

# Add deployed frontend origin here when needed, comma-separated
CORS_ORIGINS=

# Public-source intelligence is zero-cost and uses public RSS/feeds.
# It never auto-orders evacuation; authorized officer verification is required.
OSINT_SCAN_MINUTES=30
