# RISKSETU AI — Environment Configuration Template
# Copy this file to .env and adjust for your local setup.
# In production/staging, never commit .env; inject variables via your deployment system.

# --- Application Identity & Mode ---
APP_NAME="RISKSETU AI"
# Options: local, test, staging, production
APP_ENV=local
DEBUG=true

# --- Database (PostgreSQL + PostGIS) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://risksetu:risksetu@localhost:5432/risksetu
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# --- Redis (Cache & Rate Limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Security & JWT Authentication ---
# CRITICAL: In production/staging, this MUST be a cryptographically secure random string
# with at least 32 characters (256-bit entropy). Placeholders will be rejected at startup.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_LOCAL_DEV_ONLY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT_PER_MINUTE=60

# --- CORS (Cross-Origin Resource Sharing) ---
# JSON array of allowed origins. Wildcard ("*") is strictly forbidden in production.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Observability & Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Demo Mode ---
OFFLINE_DEMO_MODE=true
